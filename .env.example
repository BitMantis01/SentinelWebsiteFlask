# SENTINEL - Environment Configuration Template
# Instructions: Copy this file to '.env' and fill in your configuration values.
# WARNING: Never commit '.env' with real secrets to version control!

# Flask Secret Key (REQUIRED in production - generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-super-secret-key-change-this-in-production

# Environment Setting (production / development)
FLASK_ENV=development
FLASK_DEBUG=True

# Database Connection (SQLite by default, PostgreSQL/MySQL supported)
DATABASE_URL=sqlite:///site.db

# Account Security & Lockout Policy
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
SESSION_LIFETIME_HOURS=24

# Rate Limiting (Requests per minute)
LOGIN_RATE_LIMIT=5
API_RATE_LIMIT_VITALS=60
API_RATE_LIMIT_ENVIRONMENT=60
API_RATE_LIMIT_CAMERA=30

# CORS & WebSocket Allowed Origins (Comma-separated)
SOCKETIO_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:1904

# Cloudflare Proxy Configuration
BEHIND_CLOUDFLARE=false
PROXY_COUNT=1

# Cloudflare Turnstile CAPTCHA (Optional - leave empty to disable)
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Application Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Centralized Remote Logging (Optional)
LOG_API_URL=https://your-logging-server.com/api/logs
LOG_API_KEY=your_remote_logging_api_key_here
